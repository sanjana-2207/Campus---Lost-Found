# ============================================================
#  Copy this file to db.properties and fill in your values.
#  db.properties is local-only and ignored by git.
# ============================================================
# 1. Create the schema:
#       mysql -u root -p < database/schema.sql
# 2. Create the least-privilege application user:
#       mysql -u root -p < database/setup-user.sql
# 3. Run the application. Environment variables CAMPUS_DB_URL,
#    CAMPUS_DB_USER and CAMPUS_DB_PASSWORD override these values.
# ============================================================

db.url=jdbc:mysql://localhost:3306/campus_lost_found?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=campus_app
db.password=campus_app_pw
